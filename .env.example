# Conexión a PostgreSQL
DATABASE_URL="postgresql://usuario:clave@localhost:5432/pardave?schema=public"

# Clave para firmar las sesiones del panel (mínimo 32 caracteres). Genera una con:
#   openssl rand -base64 48
SESSION_SECRET="cambia-esta-clave-por-una-larga-y-aleatoria"

# Usuario administrador creado por `npm run db:seed`
ADMIN_EMAIL="admin@pardave.pe"
ADMIN_PASSWORD="Pardave2026!"

# URL pública del sitio
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

